<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="admin.token.edit" template="" lang="" group="0" version="19.2" layout="edit">
		<et2-hbox  span="all" hidden="!@token">
			<et2-textbox  label="Token" class="token et2-label-fixed" id="token" readonly="true" onclick="app.admin.copyClipboard(this)"></et2-textbox>
			<et2-button  id="copy_token" image="copy" noSubmit="true" statustext="Copy to clipboard" onclick="app.admin.copyClipboard(document.querySelector('#admin-token-edit_token'))"/>
		</et2-hbox>
		<et2-password  label="Current password" id="password" required="true" hidden="@admin"></et2-password>
		<et2-select-account  label="User" id="account_id" accountType="accounts" emptyLabel="All users" hidden="!@admin"></et2-select-account>
		<et2-select-app  label="Applications" id="token_apps" multiple="true" placeholder="All applications of the user" helpText="Select the applications you want the token to be limited to, or leave the default of all applications."></et2-select-app>
		<et2-date  label="Expiration" id="token_valid_until" dataFormat="object"></et2-date>
		<et2-ai  span="all"><et2-textarea  label="Remark" class="et2-label-fixed" id="token_remark" rows="5"></et2-textarea></et2-ai>
		<et2-hbox  class="dialogMeta" hidden="!@token_id">
			<et2-description  value="Creator" for="token_created_by"></et2-description>
			<et2-hbox>
				<et2-select-account  id="token_created_by" readonly="true"></et2-select-account>
				<et2-date-time  id="token_created" readonly="true"></et2-date-time>
			</et2-hbox>
		</et2-hbox>
		<et2-hbox  class="dialogMeta" hidden="!@token_updated_by">
			<et2-description  value="Last updated" for="token_updated_by"></et2-description>
			<et2-hbox>
				<et2-select-account  id="token_updated_by" readonly="true"></et2-select-account>
				<et2-date-time  id="token_updated" readonly="true"></et2-date-time>
			</et2-hbox>
		</et2-hbox>
		<et2-hbox  class="dialogMeta" hidden="!@token_revoked">
			<et2-description  value="Revoked" for="token_revoked_by"></et2-description>
			<et2-hbox>
				<et2-select-account  id="token_revoked_by" readonly="true"></et2-select-account>
				<et2-date-time  id="token_revoked" readonly="true"></et2-date-time>
			</et2-hbox>
		</et2-hbox>
		<et2-checkbox  id="new_token" label="Generate new token and display it once after saving" span="all" hidden="@token"></et2-checkbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  accesskey="s" label="Save" id="button[save]"></et2-button>
			<et2-button  label="Apply" id="button[apply]"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" noValidation="true"></et2-button>
			<et2-button  align="right" label="Revoke" id="button[delete]" onclick="Et2Dialog.confirm(widget,'Revoke this token','Revoke')"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
