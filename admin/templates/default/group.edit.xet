<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="admin.group.edit.members" template="" lang="" group="0" version="1.9.001">
		<et2-select-account  id="account_members" multiple="true" accountType="accounts" required="true" rows="5"></et2-select-account>
	</et2-template>
	<et2-template  id="admin.group.edit.apps" template="" lang="" group="0" version="1.9.001">
		<grid width="100%" id="apps" overflow="auto" height="250" resize_ratio="1">
			<columns>
				<column width="44px"/>
				<column/>
				<column/>
			</columns>
			<rows>
				<row>
					<et2-appicon  align="center" src="$row_cont[appname]"></et2-appicon>
					<et2-checkbox  label="$row_cont[appname]" id="${row}[run]"></et2-checkbox>
					<et2-button  label="ACL" id="button[$row_cont[appname]]" image="edit" title="Edit ACL" onclick="app.admin.aclGroup"></et2-button>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="admin.group.edit" template="" lang="" group="0" version="1.9.002" layout="edit" style="--label-width:9em;">
		<et2-hbox  class="dialogHeader">
			<et2-textbox  label="Group name" class="et2-label-fixed" id="account_lid" maxlength="64" onchange="app.admin.changeGroup" required="true"></et2-textbox>
		</et2-hbox>
		<et2-textbox  label="Description" id="account_description" maxlength="64" span="all"></et2-textbox>
		<et2-url-email  label="EMail" id="account_email" maxlength="64" hidden="!@mailAllowed"></et2-url-email>
		<et2-textbox  label="Filesystem quota" id="quota" disabled="!@epl" placeholder="@default_quota"></et2-textbox>
		<et2-textbox  label="Container" id="account_dn" maxlength="255" disabled="@disable_dn" statustext="Can be used to show groups by container, if enabled"></et2-textbox>
		<et2-checkbox  id="hidden" label="Group hidden from non-admins" span="all"></et2-checkbox>
		<et2-tabbox  id="tabs" tabHeight="auto">
			<tabs>
				<tab id="members" label="Members" statustext="Users in this group"/>
				<tab id="apps" label="Applications" statustext="Applications this group can use"/>
			</tabs>
			<tabpanels>
				<et2-template  id="admin.group.edit.members"></et2-template>
				<et2-template  id="admin.group.edit.apps"></et2-template>
			</tabpanels>
		</et2-tabbox>
		<et2-hbox  class="dialogFooterToolbar">
			<et2-button  label="Save" id="button[save]"></et2-button>
			<et2-button  label="Apply" id="button[apply]"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" onclick="window.close();"></et2-button>
			<et2-button  align="right" label="Delete" id="button[delete]" onclick="app.admin.deleteGroup"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
