<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="admin.customfield_edit.settings" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:8em">
		<et2-select  label="Type" span="all" id="cf_type2" rows="5" multiple="true" placeholder="All" noLang="1" hidden="@no_types"></et2-select>
		<et2-textbox  label="Label" statustext="the text displayed to the user" id="cf_label" maxlength="128" span="all"></et2-textbox>
		<et2-select  label="Type of field" statustext="Type of customfield" id="cf_type" onchange="app.admin.cf_type_change"></et2-select>
		<et2-checkbox  id="cf_needed" label="Required"></et2-checkbox>
		<et2-select-account  label="Private" statustext="Select accounts for which the custom field should be visible" id="cf_private" rows="3" span="all" multiple="1" placeholder="Add user or group" accountType="both" hidden="!@use_private"></et2-select-account>
		<et2-ai  span="all"><et2-textarea  label="Options" class="et2-label-fixed" statustext="@statustext" id="cf_values" rows="5"></et2-textarea></et2-ai>
		<et2-number  label="Length" statustext="displayed length of input field (set rows=1 to limit length)" id="cf_len" precision="0"></et2-number>
		<et2-number  label="Rows" statustext="number of row for a multiline inputfield or line of a multi-select-box" id="cf_rows" min="0" precision="0" placeholder="1"></et2-number>
		<et2-number  label="Order" statustext="determines the order the fields are displayed" id="cf_order" min="1" precision="0"></et2-number>
		<et2-textbox  label="Tab" id="cf_tab" maxlength="64" placeholder="custom fields tab" statustext="Name of tab to create and show field in"></et2-textbox>
	</et2-template>
	<et2-template  id="admin.customfield_edit" template="" lang="" group="0" version="1.9.001" layout="edit" style="--label-width:8em">
		<et2-hbox  class="dialogHeader">
			<et2-textbox  label="Name" class="et2-label-fixed" style="flex:1; margin-right:3.5em" statustext="internal name max. 64 chars" id="cf_name" maxlength="64" required="true"></et2-textbox>
			<et2-appicon  style="position:absolute; top:0; right:0; width:3.2em; height:3.2em"></et2-appicon>
		</et2-hbox>
		<et2-tabbox  id="tabs" class="et2_nowrap" tabHeight="auto">
			<tabs>
				<tab id="settings" label="Settings" statustext="Settings"/>
			</tabs>
			<tabpanels>
				<et2-template  id="admin.customfield_edit.settings"></et2-template>
			</tabpanels>
		</et2-tabbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  statustext="Saves this entry" label="Save" id="button[save]" image="save"></et2-button>
			<et2-button  statustext="Apply the changes" label="Apply" id="button[apply]" image="apply"></et2-button>
			<et2-button  statustext="leave without saveing the entry" label="Cancel" id="button[cancel]" onclick="window.close();" image="cancel"></et2-button>
			<et2-button  align="right" statustext="delete this entry" label="Delete" id="button[delete]" image="delete" onclick="Et2Dialog.confirm(widget,'Delete this entry?','Delete')"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
