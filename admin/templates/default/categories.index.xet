<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="admin.categories.index.rows" template="" lang="" group="0" version="1.9.002">
		<grid width="100%">
			<columns>
				<column width="45%"/>
				<column width="52%"/>
				<column width="174"/>
				<column width="170"/>
				<column disabled="@no_access" width="106"/>
				<column width="56"/>
				<column width="80"/>
				<column/>
				<column width="30"/>
			</columns>
			<rows>
				<row class="th">
					<et2-nextmatch-sortheader  label="Name" id="name"/>
					<et2-nextmatch-sortheader  label="Description" id="description"/>
					<!-- Global categories belong to no application, so admin_categories::index() blanks
					     this filter's options there.  The legacy widget hid it via
					     $readonlys['nm']['rows']['app']; the generated filterbox does not read
					     readonlys, so it needs telling separately - and the disable travels into the
					     generated filter template because api/filter-template.php copies a header's
					     remaining attributes through onto the control it builds. -->
					<et2-nextmatch-header-filter  label="Application" id="app" disabled="@no_app_filter"></et2-nextmatch-header-filter>
					<et2-nextmatch-header-account  label="Owner" id="owner" emptyLabel="all" accountType="both"></et2-nextmatch-header-account>
					<et2-nextmatch-header-filter  label="Private" id="access" emptyLabel="All"></et2-nextmatch-header-filter>
					<et2-nextmatch-header  align="center" label="Icon" id="icon"></et2-nextmatch-header>
					<et2-nextmatch-header  label="Color" id="color"></et2-nextmatch-header>
					<et2-nextmatch-sortheader  label="Modified" id="last_mod"/>
					<et2-nextmatch-header  align="center" label="Children" id="subs"></et2-nextmatch-header>
				</row>
				<row class="$row_cont[id] $row_cont[class]">
					<et2-hbox  cellpadding="0" cellspacing="0" >
						<et2-html  id="${row}[level_spacer]" class="level_spacer"></et2-html>
						<et2-description  id="${row}[name]" class="$row_cont[class]" noLang="true"></et2-description>
					</et2-hbox>
					<et2-description  id="${row}[description]"></et2-description>
					<et2-select  id="${row}[appname]" readonly="true"></et2-select>
					<et2-select-account  id="${row}[owner]" readonly="true" emptyLabel="All users" accountType="groups"></et2-select-account>
					<et2-checkbox  align="center" id="${row}[access]" readonly="true" selectedValue="private" unselectedValue="public" ></et2-checkbox>
					<et2-image  align="center" label="{$row_cont['data']['icon']}" src="$row_cont[icon_url]"></et2-image>
					<et2-description  id="${row}[data][color]"></et2-description>
					<et2-date-time  id="${row}[last_mod]" readonly="true"></et2-date-time>
					<et2-description  align="center" id="${row}[subs]"></et2-description>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</et2-template>
    <et2-template  id="admin.categories.index.header">
        <et2-toolbar  id="cats-toolbar">
            <et2-button  label="Add" id="add" slot="prefix" onclick="egw.open_link(widget.getRoot().getArrayMgr('content').getEntry('add_link'),'_blank','600x380'); return false;" noSubmit="true"></et2-button>
			<et2-template  template="api.search-button" slot="prefix"></et2-template>
            <et2-select  id="filter" noLang="1" emptyLabel="All categories" label="Filter" onchange="app.admin.changeNmFilter"></et2-select>
            <et2-select  id="owner" emptyLabel="Owner" onchange="app.admin.changeNmFilter"></et2-select>
            <et2-button-icon  id="back_to_list" image="back" label="Back to list" slot="suffix" onclick="widget.closest('egw-app').refresh(); return false;" noSubmit="true"></et2-button-icon>
        </et2-toolbar>
	</et2-template>
	<et2-template  id="admin.categories.index" template="" lang="" group="0" version="1.9.001" layout="stack">
        <et2-template  template="admin.categories.index.header" slot="main-header"></et2-template>
        <et2-nextmatch  id="nm" template="admin.categories.index.rows" grow="1"></et2-nextmatch>
		<!-- The "Change owner" mass action.  This used to be an <et2-box class="action_popup prompt">
		     shown by CSS, which nm_open_popup() upgraded into a dialog at runtime and whose buttons
		     relied on the window.nm_popup_action/nm_popup_ids globals that upgrade set.  As a real
		     <et2-dialog> none of that runs, so the buttons submit through app.admin.submit_popup()
		     instead.  The inner <et2-box id="owner_popup"> keeps the namespace admin_categories::index()
		     expects: it merges $content['owner_popup'] up before reading $content['owner_action']. -->
		<et2-dialog  id="owner_popup_dialog" title="Change owner" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="owner_popup">
				<et2-vbox>
					<et2-description  value="Select owner"></et2-description>
					<et2-select  id="owner" rows="4" class="action_popup-content" multiple="1" noLang="1"></et2-select>
				</et2-vbox>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Add" id="owner_popup[owner_action][add]" onclick="return app.admin.submit_popup(ev, widget, 'owner');"></et2-button>
			<et2-button  slot="footer" label="Delete" id="owner_popup[owner_action][delete]" onclick="return app.admin.submit_popup(ev, widget, 'owner');"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="owner_action_cancel" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
		<et2-styles>
			.action_popup-content {
				display: block;
				padding: 2ex;
			}
		</et2-styles>
	</et2-template>
</overlay>
