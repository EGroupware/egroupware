<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="admin.mailaccount.identity" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-hbox>
			<et2-select  label="Identity" class="et2-label-fixed" id="ident_id" onchange="1" noLang="1"></et2-select>
			<et2-select  id="acc_further_identities" class="emailadmin_no_user" onchange="1"></et2-select>
		</et2-hbox>
		<et2-textbox  label="Name" id="ident_name" maxlength="128" placeholder="default your name and email"></et2-textbox>
		<et2-hbox>
			<et2-textbox  label="Your name" class="et2-label-fixed" style="flex:1" id="ident_realname" maxlength="128"></et2-textbox>
			<et2-button  label="Placeholders" id="button[placeholders]" image="question-circle" onclick="window.open(egw::link('/index.php','menuaction=addressbook.addressbook_merge.show_replacements&amp;nonavbar=1'),'_blank','dependent=yes,width=860,height=620,scrollbars=yes,status=yes'); return false;" noSubmit="true"></et2-button>
		</et2-hbox>
		<et2-textbox  label="Organisation" id="ident_org" maxlength="128"></et2-textbox>
		<et2-url-email  label="EMail address" id="ident_email" maxlength="128" hidden="@select_ident_mail"></et2-url-email>
		<et2-select  label="EMail address" id="ident_email_alias" hidden="!@select_ident_mail"></et2-select>
		<et2-ai  span="all"><et2-htmlarea  id="ident_signature" imageUpload="@signature_image_upload_url"></et2-htmlarea></et2-ai>
	</et2-template>
	<et2-template  id="admin.mailaccount.imap" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-select  label="Type" id="acc_imap_type" class="emailadmin_no_single"></et2-select>
		<et2-select  label="Login" class="emailadmin_no_single" statustext="How username get constructed" id="acc_imap_logintype"></et2-select>
		<et2-textbox  label="Username" id="acc_imap_username" class="@manual_class" maxlength="128" autocomplete="off"></et2-textbox>
		<et2-textbox  label="Domain" id="acc_domain" maxlength="128" class="emailadmin_no_single @manual_class"></et2-textbox>
		<et2-hbox>
			<et2-password  label="Password" class="et2-label-fixed" style="flex:1" id="acc_imap_password" maxlength="128" autocomplete="new-password" placeholder="Leave empty to use OAuth, if supported"></et2-password>
			<et2-description  id="acc_imap_account_id" class="emailadmin_diagnostic"></et2-description>
		</et2-hbox>
		<et2-textbox  label="Server" id="acc_imap_host" class="@manual_class" maxlength="128" span="all" placeholder="Hostname or IP"></et2-textbox>
		<et2-hbox>
			<et2-select  label="Protocol (encryption)" class="emailadmin_ssl et2-label-fixed" id="acc_imap_ssl" onchange="app.admin.wizard_imap_ssl_onchange" required="1"></et2-select>
			<et2-number  label="Port" id="acc_imap_port" class="emailadmin_port" precision="0" required="1"></et2-number>
		</et2-hbox>
		<et2-hbox  span="all" style="margin-inline-start:calc(var(--label-width, 13em) + var(--sl-spacing-medium))">
			<et2-checkbox  label="Disable certificate validation" id="acc_imap_ssl_noverify" onchange="if (widget.getValue()) Et2Dialog.show_dialog(function(button_id){ if (button_id !== Et2Dialog.YES_BUTTON) widget.value = false; }, 'Disabling certificate validation makes this connection vulnerable to a man-in-the-middle attack - only do this if you understand and accept that risk.', 'Disable certificate validation', {}, Et2Dialog.BUTTONS_YES_NO, Et2Dialog.WARNING_MESSAGE);"></et2-checkbox>
		</et2-hbox>
		<et2-groupbox  span="all" class="emailadmin_no_single emailadmin_imap_admin" summary="IMAP administration">
			<et2-vbox style="--label-width:11.8em">
				<et2-textbox  label="Admin user" class="et2-label-fixed" id="acc_imap_admin_username" maxlength="128" autocomplete="off"></et2-textbox>
				<et2-password  label="Password" class="et2-label-fixed" id="acc_imap_admin_password" maxlength="128" autocomplete="new-password"></et2-password>
				<et2-checkbox  id="acc_admin_use_without_pw" label="Use admin credentials to connect without a session-password, e.g. for SSO"></et2-checkbox>
				<et2-hbox  hidden="!@admin_actions">
					<et2-description  value="Administration" style="width:var(--label-width, 13em); margin-right:var(--sl-spacing-medium)"></et2-description>
					<et2-toolbar  id="admin_actions" defaultExecute="app.admin.account_edit_action"></et2-toolbar>
				</et2-hbox>
			</et2-vbox>
		</et2-groupbox>
	</et2-template>
	<et2-template  id="admin.mailaccount.folder" template="" lang="" group="0" version="1.9.002" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-select  label="Sent folder" id="acc_folder_sent" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Trash folder" id="acc_folder_trash" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Drafts folder" id="acc_folder_draft" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Templates folder" id="acc_folder_template" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Junk folder" id="acc_folder_junk" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Ham folder" id="acc_folder_ham" allowFreeEntries="true" searchUrl="" emptyLabel="Mails can be copied to that folder via context menu, if folder is configured."></et2-select>
		<et2-select  label="Archive folder" id="acc_folder_archive" allowFreeEntries="true" searchUrl="" emptyLabel="Select one ..."></et2-select>
		<et2-select  label="Notify about new mail in this folders" id="notify_folders" onchange="app.admin.change_folders" multiple="true" allowFreeEntries="true" searchUrl="" placeholder="Select one ..."></et2-select>
		<et2-hbox  span="all" style="margin-inline-start:calc(var(--label-width, 13em) + var(--sl-spacing-medium))">
			<et2-checkbox  id="notify_save_default" label="save as default"></et2-checkbox>
			<et2-checkbox  id="notify_use_default" label="use default"></et2-checkbox>
		</et2-hbox>
	</et2-template>
	<et2-template  id="admin.mailaccount.sieve" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-select-bool  label="Enable Sieve" id="acc_sieve_enabled" required="1"></et2-select-bool>
		<et2-textbox  label="Sieve server" id="acc_sieve_host" class="@manual_class" onchange="app.admin.wizard_sieve_onchange" maxlength="128" placeholder="Hostname or IP"></et2-textbox>
		<et2-hbox  class="@manual_class">
			<et2-select  label="Protocol (encryption)" class="emailadmin_ssl et2-label-fixed" id="acc_sieve_ssl" onchange="app.admin.wizard_sieve_ssl_onchange"></et2-select>
			<et2-number  label="Port" id="acc_sieve_port" onchange="app.admin.wizard_sieve_onchange" precision="0"></et2-number>
		</et2-hbox>
		<et2-hbox  class="@manual_class" style="margin-inline-start:calc(var(--label-width, 13em) + var(--sl-spacing-medium))">
			<et2-checkbox  label="Disable certificate validation" id="acc_sieve_ssl_noverify" onchange="if (widget.getValue()) Et2Dialog.show_dialog(function(button_id){ if (button_id !== Et2Dialog.YES_BUTTON) widget.value = false; }, 'Disabling certificate validation makes this connection vulnerable to a man-in-the-middle attack - only do this if you understand and accept that risk.', 'Disable certificate validation', {}, Et2Dialog.BUTTONS_YES_NO, Et2Dialog.WARNING_MESSAGE);"></et2-checkbox>
		</et2-hbox>
		<et2-description  value="Vacation messages with start and end date require an admin account to be set!" span="all" class="emailadmin_no_single"></et2-description>
	</et2-template>
	<et2-template  id="admin.mailaccount.smtp" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-select  label="Type" id="acc_smtp_type" class="emailadmin_no_single" onchange="1"></et2-select>
		<et2-hbox  class="emailadmin_no_single">
			<et2-description  value="Authentication" style="width:var(--label-width, 13em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-checkbox  label="Use username+password from current user" id="acc_smtp_auth_session"></et2-checkbox>
		</et2-hbox>
		<et2-textbox  label="Username" id="acc_smtp_username" class="@manual_class" maxlength="128" autocomplete="off" placeholder="if authentication required"></et2-textbox>
		<et2-hbox  class="@manual_class">
			<et2-password  label="Password" class="et2-label-fixed" style="flex:1" id="acc_smtp_password" maxlength="128" autocomplete="new-password" placeholder="Leave empty to use OAuth, if supported"></et2-password>
			<et2-description  id="acc_smtp_account_id" class="emailadmin_diagnostic"></et2-description>
		</et2-hbox>
		<et2-textbox  label="SMTP server" id="acc_smtp_host" class="@manual_class" maxlength="128" placeholder="Hostname or IP" required="1"></et2-textbox>
		<et2-hbox  class="@manual_class">
			<et2-select  label="Protocol (encryption)" class="emailadmin_ssl et2-label-fixed" id="acc_smtp_ssl" onchange="app.admin.wizard_smtp_ssl_onchange" required="1"></et2-select>
			<et2-number  label="Port" id="acc_smtp_port" precision="0" required="1"></et2-number>
		</et2-hbox>
		<et2-hbox  class="@manual_class" style="margin-inline-start:calc(var(--label-width, 13em) + var(--sl-spacing-medium))">
			<et2-checkbox  label="Disable certificate validation" id="acc_smtp_ssl_noverify" onchange="if (widget.getValue()) Et2Dialog.show_dialog(function(button_id){ if (button_id !== Et2Dialog.YES_BUTTON) widget.value = false; }, 'Disabling certificate validation makes this connection vulnerable to a man-in-the-middle attack - only do this if you understand and accept that risk.', 'Disable certificate validation', {}, Et2Dialog.BUTTONS_YES_NO, Et2Dialog.WARNING_MESSAGE);"></et2-checkbox>
		</et2-hbox>
		<et2-url  label="SpamTitan API URL" id="acc_spam_api" maxlength="128" placeholder="@spamtitan_blur"></et2-url>
		<et2-password  label="API Token" id="acc_spam_password" suggest="24" autocomplete="new-password" placeholder="@spamtitan_blur"></et2-password>
	</et2-template>
	<et2-template  id="admin.mailaccount.aliases" template="" lang="" group="0" version="1.9.001" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-hbox>
			<et2-url-email  label="EMail address" class="et2-label-fixed" style="flex:1" id="mailLocalAddress" maxlength="128"></et2-url-email>
			<et2-checkbox  label="Email account active" id="accountStatus" selectedValue="active"></et2-checkbox>
		</et2-hbox>
		<et2-email  label="Alternate email address" id="mailAlternateAddress" multiple="true" searchUrl="" emailDisplay="email"></et2-email>
		<et2-email  label="Forward email's to" id="mailForwardingAddress" hidden="@no_forward_available" multiple="true" searchUrl="" emailDisplay="email"></et2-email>
		<et2-hbox  span="all" hidden="@no_forward_available" style="margin-inline-start:calc(var(--label-width, 13em) + var(--sl-spacing-medium))">
			<et2-checkbox  label="Forward only" id="deliveryMode" onchange="if (widget.getValue()) Et2Dialog.alert('Forward only disables IMAP mailbox / storing of mails and just forwards them to given address.','Forward only');" selectedValue="forwardOnly"></et2-checkbox>
			<et2-checkbox  label="Allow users to change forwards" id="acc_user_forward"></et2-checkbox>
		</et2-hbox>
		<et2-hbox>
			<et2-number  label="Quota (MB)" class="et2-label-fixed" id="quotaLimit" precision="0"></et2-number>
			<et2-description  value="Leave empty for no quota"></et2-description>
			<et2-number  label="Currently:" id="quotaUsed" readonly="true" precision="0"></et2-number>
		</et2-hbox>
		<et2-hbox  hidden="!@admin_actions">
			<et2-description  value="Administration" style="width:var(--label-width, 13em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-toolbar  id="admin_actions" defaultExecute="app.admin.account_edit_action"></et2-toolbar>
		</et2-hbox>
	</et2-template>
	<et2-template  id="admin.mailaccount.encryption" template="" lang="" group="0" version="17.1" layout="2-column" style="--label-width:13em; --column-min-width:100%">
		<et2-hbox  span="all">
			<et2-description  value="S/MIME"></et2-description>
		</et2-hbox>
		<et2-hbox>
			<et2-description  value="Certificate" style="width:var(--label-width, 13em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-button  id="smimeGenerate" label="Create self-signed certificate" onclick="app.admin.smime_genCertificate" image="add" hideOnReadonly="true" noSubmit="true"></et2-button>
			<et2-button  id="smime_export_p12" label="export certificate as p12" onclick="app.admin.smime_exportCert" image="export" noSubmit="true"></et2-button>
			<et2-button  id="smime_export_csr" label="Export CSR" onclick="app.admin.smime_exportCsr" image="export" noSubmit="true"></et2-button>
			<et2-button  id="smime_delete_p12" label="Delete certificate" onclick="Et2Dialog.confirm(widget,'Deleting removes your S/MIME private key entirely - you will no longer be able to read any previously received encrypted messages. If you are renewing your certificate, use Export CSR and Import certificate instead to keep your key.','Delete S/MIME certificate')" image="delete" noSubmit="true"></et2-button>
		</et2-hbox>
		<et2-hbox>
			<et2-description  value="Passphrase" style="width:var(--label-width, 13em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-password  style="flex:1" id="smime_passphrase" maxlength="128" autocomplete="off" placeholder="Only if the private key (new upload, or already stored) is passphrase-protected"></et2-password>
			<et2-checkbox  id="smime_no_passphrase" label="Do NOT ask passphrase" onchange="app.admin.smime_noPassphraseChanged" statustext="Removes the passphrase from the private key (still protected by your login password) so signing, encrypting and decrypting never asks for it again"></et2-checkbox>
		</et2-hbox>
		<et2-hbox>
			<et2-description  value="Upload your certificate .p12/.pfx file" style="margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-file  id="smimeKeyUpload" accept=".p12,.pfx"></et2-file>
		</et2-hbox>
		<et2-hbox>
			<et2-description  value="Import CA-signed certificate for this key" style="width:24em; margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-file  id="smimeCertUpload" accept=".pem,.crt,.cer,.p7b" onchange="app.admin.smime_certFileChanged"></et2-file>
			<et2-button  id="smime_import_cert" label="Import certificate" onclick="app.admin.change_account" image="upload" noSubmit="true"></et2-button>
		</et2-hbox>
		<et2-hbox>
			<et2-description  value="Intermediate/CA certificate (optional)" style="width:24em; margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-file  id="smimeIntermediateUpload" accept=".pem,.crt,.cer,.p7b"></et2-file>
		</et2-hbox>
	</et2-template>
	<et2-template  id="admin.mailaccount.smimecertgen" template="" lang="" group="0" version="17.1">
		<grid width="100%">
			<columns>
				<column/>
			</columns>
			<rows>
				<row>
					<et2-groupbox  summary="Certificate details">
						<et2-vbox>
							<et2-textbox  id="countryName" maxlength="2" label="Country" placeholder="DE" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="stateOrProvinceName" label="State or province" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="localityName" label="Locality" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="organizationName" label="Organisation" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="organizationalUnitName" label="Organizational unit" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="commonName" label="Common name" class="et2-label-fixed"></et2-textbox>
							<et2-textbox  id="emailAddress" label="Email address" class="et2-label-fixed"></et2-textbox>
							<et2-number  id="validity" precision="0" label="Certificate validity in days" placeholder="3650" width="5em"></et2-number>
						</et2-vbox>
					</et2-groupbox>
				</row>
				<row>
					<et2-groupbox  summary="passphrase">
						<et2-description  value="Enter a passphrase if you would like to protect your private key by password."></et2-description>
						<et2-vbox>
							<et2-password  id="passphrase" label="Passphrase" class="et2-label-fixed"></et2-password>
							<et2-password  id="passphraseConf" label="Repeat passphrase" class="et2-label-fixed"></et2-password>
						</et2-vbox>
					</et2-groupbox>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="admin.mailaccount" template="" lang="" group="0" version="1.9.001" layout="edit" style="--label-width:13em">
		<et2-hbox  class="dialogHeader" hidden="!@accounts">
			<et2-select  label="Mail account" class="et2-label-fixed" id="acc_id" onchange="app.admin.change_account"></et2-select>
		</et2-hbox>
		<et2-hbox  class="dialogHeader">
			<et2-textbox  label="Name of account" class="et2-label-fixed" style="flex:1" id="acc_name" required="1"></et2-textbox>
			<et2-description  align="right" value="$cont[acc_id]" class="emailadmin_diagnostic"></et2-description>
		</et2-hbox>
		<et2-hbox  class="emailadmin_no_user dialogHeader2">
			<et2-select-account  label="Valid for" class="et2-label-fixed" style="flex:1" id="account_id" placeholder="Everyone" multiple="true" accountType="both" rows="1" onchange="app.admin.warnMailAccountForAllChanged"></et2-select-account>
			<et2-checkbox  label="account editable by user" id="acc_user_editable"></et2-checkbox>
		</et2-hbox>
		<et2-tabbox  id="tabs" tabHeight="auto">
			<tabs>
				<tab id="admin.mailaccount.identity" label="Identity+Signature" statustext="Identity&amp;Signature"/>
				<tab id="admin.mailaccount.imap" label="IMAP" statustext="incoming mail"/>
				<tab id="admin.mailaccount.folder" label="Folder" statustext="Folder"/>
				<tab id="admin.mailaccount.sieve" label="Sieve" statustext="serverside filtering"/>
				<tab id="admin.mailaccount.smtp" label="SMTP" statustext="outgoing mail"/>
				<tab id="admin.mailaccount.aliases" label="Aliases+Forwards" statustext="Aliases, Forwarding, Quota, ..."/>
				<tab id="admin.mailaccount.encryption" label="Encryption" statustext="Encryption settings"/>
			</tabs>
			<tabpanels>
				<et2-template  id="admin.mailaccount.identity"></et2-template>
				<et2-template  id="admin.mailaccount.imap"></et2-template>
				<et2-template  id="admin.mailaccount.folder"></et2-template>
				<et2-template  id="admin.mailaccount.sieve"></et2-template>
				<et2-template  id="admin.mailaccount.smtp"></et2-template>
				<et2-template  id="admin.mailaccount.aliases"></et2-template>
				<et2-template  id="admin.mailaccount.encryption"></et2-template>
			</tabpanels>
		</et2-tabbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  label="Save" id="button[save]"></et2-button>
			<et2-button  label="Apply" id="button[apply]"></et2-button>
			<et2-button  statustext="Use wizard to detect or verify configuration" label="Wizard" id="button[wizard]" image="magic"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" onclick="window.close();"></et2-button>
			<et2-button  align="right" label="Delete" id="button[delete]" onclick="Et2Dialog.confirm(widget,'Delete this account','Delete')" hideOnReadonly="true"></et2-button>
			<et2-button  align="right" label="Delete identity" id="button[delete_identity]" onclick="Et2Dialog.confirm(widget,'Delete identity','Delete')" hideOnReadonly="true" image="delete"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
