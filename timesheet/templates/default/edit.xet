<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <et2-template id="timesheet.edit.general" layout="2-column" style="--column-min-width:34em;">
        <et2-hbox disabled="@pm_integration=none" span="all">
            <et2-link-entry id="pm_id" label="Project" class="et2-label-fixed" onchange="app.timesheet.pm_id_changed" onlyApp="projectmanager" placeholder="None"></et2-link-entry>
        </et2-hbox>
        <et2-hbox disabled="@pm_integration=full" span="all">
            <et2-textbox id="ts_project" maxlength="80" class="et2-label-fixed" placeholder="@ts_project_blur"></et2-textbox>
        </et2-hbox>
        <et2-box span="all">
            <et2-hbox disabled="@pm_integration=none">
                <projectmanager-pricelist id="pl_id"
                                          label="Unitprice" class="et2-label-fixed"
                                          onchange="let option = this.select_options.find(e=>e.value == this.value) || {label:''};window.app.timesheet.et2.getWidgetById('ts_unitprice').set_value(option.label.lastIndexOf('(') &lt; 0 ? '' : option.label.slice(option.label.lastIndexOf('(')+1,-1));"
                                          emptyLabel="None"/>
                <et2-number id="ts_unitprice" span="all"></et2-number>
            </et2-hbox>
        </et2-box>
        <et2-box>
            <et2-number label="Quantity" class="et2-label-fixed" statustext="empty if identical to duration" id="ts_quantity" precision="3" placeholder="@ts_quantity_blur"></et2-number>
            <et2-date-duration label="Pause time" id="ts_paused" displayFormat="hm" span="all"></et2-date-duration>
        </et2-box>
        <et2-box span="all">
            <et2-select-cat label="Category" id="cat_id" class="et2-label-fixed" application="timesheet" emptyLabel="None"></et2-select-cat>
        </et2-box>
        <et2-box span="all">
            <et2-select-account label="Readable" id="ts_readable" class="et2-label-fixed" emptyLabel="Give additional users access" multiple="true"></et2-select-account>
        </et2-box>
	</et2-template>
	<et2-template  id="timesheet.edit.notes" template="" lang="" group="0" version="1.5.001"><et2-ai><et2-textarea  id="ts_description" rows="9" cols="70"></et2-textarea></et2-ai>
	</et2-template>
	<et2-template  id="timesheet.edit.links" template="" lang="" group="0" version="0.1.001">
		<grid width="100%" overflow="auto">
			<columns>
				<column width="99%"/>
			</columns>
			<rows>
				<row class="row" disabled="@status_only">
					<et2-link-to  id="link_to"></et2-link-to>
				</row>
				<row class="th">
					<et2-description  value="Existing links"></et2-description>
				</row>
				<row class="row_off" >
					<et2-link-list  id="link_to"></et2-link-list>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="timesheet.edit.history" template="" lang="" group="0" version="1.7.001">
		<historylog id="history"/>
	</et2-template>
	<et2-template  id="timesheet.edit.events" template="" lang="" group="0" version="0.1.001">
		<grid width="100%" overflow="auto" id="events">
			<columns>
				<column/>
				<column/>
				<column/>
				<column/>
				<column/>
				<column/>
			</columns>
			<rows>
				<row class="th">
					<et2-description  value="Time"></et2-description>
					<et2-description  value="Recorded"></et2-description>
					<et2-description  value="Type"></et2-description>
					<et2-description  value="Duration"></et2-description>
					<et2-description  value="Paused"></et2-description>
					<et2-description  value="Sum"></et2-description>
				</row>
				<row id="timesheet-events::$row_cont[tse_id]">
					<et2-date-time  id="${row}[tse_time]" readonly="true" class="et2_clickable" onclick="app.timesheet.editEventTime"></et2-date-time>
					<et2-date-time  id="${row}[tse_timestamp]" readonly="true"></et2-date-time>
					<et2-select  id="${row}[tse_type]" readonly="true"></et2-select>
					<et2-date-duration  id="${row}[time]" readonly="true" displayFormat="h:m" dataFormat="s"></et2-date-duration>
					<et2-date-duration  id="${row}[paused]" readonly="true" displayFormat="h:m" dataFormat="s"></et2-date-duration>
					<et2-date-duration  id="${row}[total]" readonly="true" displayFormat="h:m" dataFormat="s"></et2-date-duration>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="timesheet.edit.events.change" template="" lang="" group="0" version="1.7.002">
		<et2-date-time  id="time" required="true"/>
	</et2-template>
	<et2-template  id="timesheet.edit.conflicts" template="" lang="" group="0" version="1.9.002">
		<et2-dialog  title="Scheduling conflict" open="@has_conflicts" buttons="" destroyOnClose="false" isModal="true">
			<et2-description  value="This timesheet overlaps with the following existing entries:"></et2-description>
			<grid width="100%" id="conflicts">
				<columns>
					<column/>
					<column/>
					<column/>
				</columns>
				<rows>
					<row class="th">
						<et2-description  value="Title"></et2-description>
						<et2-description  value="Starttime"></et2-description>
						<et2-description  value="Duration"></et2-description>
					</row>
					<row id="timesheet-conflict::$row_cont[ts_id]">
						<et2-description  id="${row}[ts_title]"></et2-description>
						<et2-date-time  id="${row}[ts_start]" readonly="true"></et2-date-time>
						<et2-date-duration  id="${row}[ts_duration]" readonly="true" displayFormat="hm"></et2-date-duration>
					</row>
				</rows>
			</grid>
			<et2-button  slot="footer" label="Ignore conflict" image="check" noSubmit="true" id="ignoreConflict" onclick="app.timesheet.ignoreConflict(event, widget);"></et2-button>
			<et2-button  slot="footer" label="Re-edit timesheet" image="edit" noSubmit="true" onclick="widget.closest('et2-dialog').close();"></et2-button>
			<et2-checkbox  slot="footer" align="right" id="no_conflict_warning" label="Do not warn again" statustext="Switch off the warning about overlapping timesheets, you can re-enable it in your preferences" onchange="egw.set_preference('timesheet', 'conflict_warning', widget.get_value() ? '0' : '1');"></et2-checkbox>
		</et2-dialog>
		<et2-hidden  id="ignore_conflicts"></et2-hidden>
		<et2-hidden  id="conflict_button"></et2-hidden>
	</et2-template>
    <et2-template id="timesheet.edit" layout="edit">
        <et2-template  id="timesheet.edit.conflicts"></et2-template>
        <et2-hbox exportparts="base" class="dialogHeader">
            <et2-textbox label="Title" id="ts_title" maxlength="255" class="et2_required et2-label-fixed" tabindex="1" span="4" placeholder="@ts_title_blur"></et2-textbox>
            <et2-number id="ts_id" readonly="true" precision="0"></et2-number>
            <et2-appicon src="timesheet"></et2-appicon>
        </et2-hbox>

        <et2-date label="Date" id="ts_start" required="1" onchange="app.timesheet.ts_start_changed"></et2-date>
        <et2-date-timeonly label="Starttime" id="start_time" freeMinuteEntry="true"></et2-date-timeonly>

        <et2-date-duration label="Duration" id="ts_duration" displayFormat="hm"
                                       onchange="app.timesheet.update_quantity"></et2-date-duration>
        <et2-date-timeonly label="or endtime" id="end_time" freeMinuteEntry="true"></et2-date-timeonly>

        <et2-tabbox id="tabs" tabHeight="auto">
						<tabs>
							<tab id="notes" label="Description"/>
							<tab id="general" label="Details"/>
							<tab id="links" label="Links"/>
							<tab id="history" label="History"/>
							<tab id="events" label="Events"/>
						</tabs>
						<tabpanels class="dialog-main-timeframe">
							<et2-template  id="timesheet.edit.notes"></et2-template>
							<et2-template  id="timesheet.edit.general"></et2-template>
							<et2-template  id="timesheet.edit.links"></et2-template>
							<et2-template  id="timesheet.edit.history"></et2-template>
							<et2-template  id="timesheet.edit.events"></et2-template>
						</tabpanels>
					</et2-tabbox>

        <et2-select label="User" id="ts_owner" span="2" noLang="1"></et2-select>
        <et2-select label="Status" span="3" statustext="select a status of the timesheet" id="ts_status" disabled="@no_ts_status" emptyLabel="please select"></et2-select>

        <et2-description value="Last modified"></et2-description>
					<et2-hbox  span="3">
						<et2-select-account  id="ts_modifier" readonly="true"></et2-select-account>
						<et2-date-time  id="ts_modified" readonly="true" align="left" disabled="!@ts_modified"></et2-date-time>
					</et2-hbox>
        <et2-date-time label="Created" id="ts_created" readonly="true" align="left"></et2-date-time>


        <et2-hbox class="dialogFooterToolbar">
						<et2-hbox>
							<et2-button  hideOnReadonly="true" statustext="Edit this entry" label="Edit" id="button[edit]" image="edit"></et2-button>
                            <et2-dropdown-button  id="save_split" statustext="Saves the changes made" defaultPreference="save_new" onclick="app.timesheet.save_split_action" onchange="app.timesheet.save_split_action">
                                <et2-image  slot="prefix" src="save_new"/>
                                <option value="save_new" default="save_new">Save &amp; New</option>
                                <option value="save_reset">Save &amp; Reset</option>
                            </et2-dropdown-button>
                            <et2-button  hideOnReadonly="true" label="Save" id="button[save]" image="save" tabindex="-1"/>
                            <et2-button  hideOnReadonly="true" label="Save &amp; New" id="button[save_new]" image="save_new" style="display:none" tabindex="-1"/>
                            <et2-button  hideOnReadonly="true" label="Save &amp; Reset" id="button[save_reset]" image="reload" style="display:none" tabindex="-1"/>
                            <et2-button  hideOnReadonly="true" statustext="Applies the changes made" label="Apply" id="button[apply]" image="apply"></et2-button>
							<et2-button  statustext="closes the window without saving the changes" label="Cancel" id="button[cancel]" onclick="window.close();" image="cancel"></et2-button>
							<et2-html  id="js"></et2-html>
						</et2-hbox>
                        <et2-button  hideOnReadonly="true" align="right" statustext="Delete this entry" label="Delete" id="button[delete]" onclick="Et2Dialog.confirm(widget,'Delete this entry','Delete')" image="delete"></et2-button>
						<et2-button  hideOnReadonly="true" align="right" statustext="Restore this entry" label="Undelete" id="button[undelete]" image="undelete"></et2-button>
					</et2-hbox>
    </et2-template>
</overlay>
