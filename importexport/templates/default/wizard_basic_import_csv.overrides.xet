<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="importexport.wizard_basic_import_csv.overrides" template="" lang="" group="0" version="1.9.001">
		<grid id="override_values">
			<columns>
				<column/>
				<column/>
			</columns>
			<rows>
				<row>
					<et2-description  value="Category"></et2-description>
					<!-- "@@" reads the root content: the grid's id opens an "override_values"
					     namespace, but the application of the definition being edited only exists
					     one level up. A namespace-relative reference resolves to '', and the
					     selector then falls back to the current app (importexport), offering
					     nothing but the super-global categories. -->
					<et2-select-cat  id="cat_id[value]" application="@@application" emptyLabel="From file"></et2-select-cat>
				</row>
				<row>
					<et2-description></et2-description>
				</row>

			</rows>
		</grid>
	</et2-template>
</overlay>
