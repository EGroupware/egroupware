<?xml version="1.0" encoding="UTF-8"?>
<!-- Run tests using phpunit -c doc/phpunit.xml -->
<phpunit
    colors="true"
	backupGlobals="false"
	bootstrap="phpunit_bootstrap.php"
>
	<php>
        <!-- Local override without committing: EGW_URL="http://your-host/egroupware" vendor/bin/phpunit -c doc/phpunit.xml -->
        <env name="EGW_URL" value="http://localhost/egroupware"/>
        <var name="EGW_DOMAIN" value="default" />
        <var name="EGW_USER" value="demo" />
        <var name="EGW_PASSWORD" value="guest" />
        <!-- Real, DB-backed admin account - for tests exercising admin-only functionality
             (eg. admin_cmd_edit_user/_edit_group), switch to this via LoggedInTest::switchUser()
             rather than granting EGW_USER admin rights, which would short-circuit the many tests
             relying on EGW_USER NOT being an admin.
             This is "sysop", the account every EGroupware install already creates during setup -
             NOT a separate test-only account: a dedicated "demoadmin"-style account previously
             used here collided with "demo" in several apps' generous name-matching lookups
             (eg. calendar_import_csv::parse_participants(), which resolves "demo" via an
             addressbook LIKE '%demo%' search that a same-prefixed second account also matches),
             causing spurious failures across calendar/infolog/projectmanager tests.
             sysop's password is generated fresh per install, so it can't be committed here -
             override via shell: EGW_ADMIN_PASSWORD="..." vendor/bin/phpunit -c doc/phpunit.xml -->
        <var name="EGW_ADMIN_USER" value="sysop" />
        <env name="EGW_ADMIN_PASSWORD" value=""/>
    </php>
	    <testsuites>
	        <testsuite name="Api">
	            <directory>../api/tests</directory>
	            <exclude>../api/tests/Etemplate/</exclude>
	            <exclude>../api/tests/EtemplateTest.php</exclude>
	            <exclude>../api/tests/AppTest.php</exclude>
	            <exclude>../api/tests/CalDAVTest.php</exclude>
	            <exclude>../api/tests/WebDAVTest.php</exclude>
	            <exclude>../api/tests/LoggedInTest.php</exclude>
	        </testsuite>
	        <testsuite name="Etemplate">
	            <file>../api/tests/EtemplateTest.php</file>
	            <directory>../api/tests/Etemplate/</directory>
	            <exclude>../api/tests/Etemplate/WidgetBaseTest.php</exclude>
	        </testsuite>
		<testsuite name="Apps">
			<!-- Apps with test directory -->
			<directory>../*/tests/</directory>

            <!-- Already done under "Api" testsuite -->
            <exclude>../api</exclude>
		</testsuite>
    </testsuites>
</phpunit>
