<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <et2-template  id="resources.customfields.types">
    </et2-template>
    <et2-template  id="resources.customfields.add" template="" lang="" group="0" version="1.9.001">
        <et2-button  label="Add" id="add" onclick="egw.open_link('resources.resources_customfields.edit&amp;appname='+widget.getArrayMgr('content').getRoot().getEntry('nm[appname]'),false,'450x380');" noSubmit="true"></et2-button>
    </et2-template>
    <et2-template  id="resources.admin.types" template="" lang="" group="0" version="">
        <et2-template  id="resources.customfields.types" content="content_types"></et2-template>
        <et2-styles>.header{
            font-weight: bold;
            }
        </et2-styles>
    </et2-template>
</overlay>
