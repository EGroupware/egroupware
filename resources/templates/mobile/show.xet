<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="resources.show.rows" template="" lang="" group="0" version="1.9.003">
		<grid width="100%">
			<columns>
				<column width="90%"/>
				<column width="130"/>
				<column width="70"/>
			</columns>
			<rows>
				<row class="th">
				</row>
				<!-- the category placeholder lets the list colour the row by category -->
				<row class="$row_cont[cat_id] $row_cont[class]">
					<et2-vbox>
						<et2-customfields-list  id="$row" class="customfields" app="resources" disabled="true"></et2-customfields-list>
						<et2-description  id="${row}[name]" class="resource_name" noLang="1"></et2-description>
						<et2-description  id="${row}[short_description]" class="resource_ellipsis" noLang="1"></et2-description>
						<et2-hbox>
							<et2-description  href="resources.resources_ui.edit&amp;res_id=$row_cont[accessory_of]" id="${row}[accessory_of_label]" class="resource_ellipsis" extraLinkPopup="850x600" noLang="1"></et2-description>
							<!-- was a repeating <grid> over ${row}[accessories], see the desktop template -->
							<et2-link-string  id="${row}[accessory_links]" class="resource_ellipsis"></et2-link-string>
						</et2-hbox>
					</et2-vbox>
					<et2-vbox  class="resourcesCol2">
						<et2-hbox>
							<et2-label  value="Useable"></et2-label>
							<et2-description  align="left" id="${row}[useable]" noLang="1"></et2-description>
						</et2-hbox>
						<et2-hbox>
							<et2-label  value="Quantity"></et2-label>
							<et2-description  align="left" id="${row}[quantity]" noLang="1"></et2-description>
						</et2-hbox>
						<et2-select-cat  id="${row}[cat_id]" readonly="true" noLang="1"></et2-select-cat>
					</et2-vbox>
					<et2-vbox>
						<et2-hbox  class="avatar">
							<et2-image-expose  id="${row}[picture_thumb]" width="50px" height="50px" href="$row_cont[picture_original]" src="${row}[picture_thumb]" ></et2-image-expose>
						</et2-hbox>
					</et2-vbox>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</et2-template>
	<et2-template  id="resources.show" template="" lang="" group="0" version="1.9.003">
		<et2-description  align="center" id="msg" class="message" disabled="!@msg"></et2-description>
		<et2-description  id="plus_button_container"></et2-description>
		<et2-nextmatch  id="nm" noLang="1" template="resources.show.rows"></et2-nextmatch>
		<et2-button-icon  class="plus_button" id="add_button" onclick="window.open(egw::link('/index.php','menuaction=resources.resources_ui.edit'),'','dependent=yes,width=800,height=600,location=no,menubar=no,toolbar=no,scrollbars=yes,status=yes'); return false;" noSubmit="true" image="plus-lg"></et2-button-icon>
		<!-- the delete / un-delete dialogs, see the desktop template -->
		<et2-dialog  id="delete_popup_dialog" title="Delete" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="delete_popup">
				<et2-description  value="Delete accessories of selected resources too?"></et2-description>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Yes - Delete accessories too" id="delete_popup[accessories]" onclick="return app.resources.submit_popup(ev, widget, 'delete');"></et2-button>
			<et2-button  slot="footer" label="No - Make them resources" id="delete_popup[promote]" onclick="return app.resources.submit_popup(ev, widget, 'delete');"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="delete_popup_cancel" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
		<et2-dialog  id="restore_popup_dialog" title="Un-delete" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="restore_popup">
				<et2-description  value="Un-delete accessories of selected resources too?"></et2-description>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Yes - Un-delete accessories too" id="restore_popup[accessories]" onclick="return app.resources.submit_popup(ev, widget, 'restore');"></et2-button>
			<et2-button  slot="footer" label="No - Leave them" id="restore_popup[leave]" onclick="return app.resources.submit_popup(ev, widget, 'restore');"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="restore_popup_cancel" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
	</et2-template>
</overlay>
