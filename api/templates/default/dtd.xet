<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="etemplate.dtd" template="" lang="" group="0" version="1.9.001">
		<et2-vbox>
			<et2-label  id="message"></et2-label><et2-ai><et2-textarea  id="value" rows="20" class="dtdContent"></et2-textarea></et2-ai>
		</et2-vbox>
		<et2-styles>
			.dtdContent {
				width: 550px;
				height: 400px;
				resize: none;
			}
		</et2-styles>
	</et2-template>
</overlay>
