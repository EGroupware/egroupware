<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <et2-template  id="etemplate.placeholder_snippet" template="" lang="" group="0" version="21.1.001">
        <et2-vbox  id="outer_box">
            <et2-vbox  id="selects">
                <et2-select  id="app"></et2-select>
                <et2-listbox  id="placeholder_list" rows="10"/>
            </et2-vbox>
            <hrule/>
            <et2-link-entry  id="entry" label="Select entry" onlyApp="addressbook"></et2-link-entry>
            <et2-hbox  class="preview">
                <et2-description  id="preview_content"></et2-description>
            </et2-hbox>
        </et2-vbox>
        <et2-styles>
            /**
             * The dialog gets a fixed size when it opens, so the preview needs its space reserved
             * up front: it starts empty and is only filled once an entry is picked, and without a
             * share of the height the merged address would land outside the dialog where it can't
             * be seen.
             */
            #placeholder_snippet {
            min-width: 500px;
            min-height: 25em;
            display: flex;
            }
            #placeholder_snippet > et2-template {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            }
            #placeholder_snippet #outer_box {
            flex: 1 1 auto;
            }
            #placeholder_snippet #selects {
            flex: 1 1 60%;
            min-height: 8em;
            }
            #placeholder_snippet #placeholder_list {
            flex: 1 1 auto;
            min-height: 0;
            }
            #placeholder_snippet .preview {
            flex: 1 1 40%;
            min-height: 6em;
            overflow: auto;
            font-size: larger;
            }
            #placeholder_snippet #app {
            flex-grow: 0;
            }
        </et2-styles>
    </et2-template>
</overlay>
