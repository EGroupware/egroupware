<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="api.promptOpenedDialog" template="" lang="" group="0" version="23.1">
        <grid id="grid">
            <columns>
                <column/>
                <column/>
                <column/>
            </columns>
            <rows>
                <row>
                    <radio id="index" set_value="$row_cont[index]"/>
                    <et2-description></et2-description>
                    <et2-description  id="${row}[label]" for="$row_cont[index]"></et2-description>
                </row>
            </rows>
        </grid>
    </et2-template>
</overlay>
