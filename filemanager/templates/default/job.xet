<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="filemanager.job.general" template="" lang="" group="0" version="1.9.002" layout="2-column">
		<et2-select label="Type" hidden="!@app=infolog"  id="info_type" onchange="1"></et2-select>
		<et2-select-account label="Owner" hidden="!@app=infolog"  id="info_owner" accountType="both" emptyLabel="Select one..."></et2-select-account>
		<et2-select-account label="Responsible" hidden="!@app=infolog"  id="info_responsible" accountType="both" multiple="true"></et2-select-account>
		<et2-select-cat label="Category" hidden="!@app=infolog"  id="info_cat" application="infolog"></et2-select-cat>
		<et2-select hidden="@no_cfs" label="Creationdate of file"  id="file_created" emptyLabel="Startdate"></et2-select>
		<et2-vfs-path label="Move file to"  id="target_dir" statustext="leave empty to delete the file after attaching"></et2-vfs-path>
	</et2-template>
	<et2-template  id="filemanager.job.custom" template="" lang="" group="0" version="1.9.001">
		<customfields app="infolog" type_filter="@info_type" disabled="!@app=infolog"></customfields>
	</et2-template>
	<et2-template  id="filemanager.job" template="" lang="" group="0" version="1.9.002" layout="edit">
		<et2-textbox span="all" label="Name"  id="name"></et2-textbox>
		<et2-vfs-path span="all" label="Directory"  id="directory"></et2-vfs-path>
		<et2-select label="Application"  id="app" onchange="1"></et2-select>
		<et2-tabbox  id="tabs" tabHeight="auto">
			<tabs>
				<tab id="error" label="Error running job"></tab>
				<tab id="general" label="General"></tab>
				<tab id="custom" label="Custom fields"></tab>
			</tabs>
			<tabpanels>
				<et2-vbox>
					<et2-date-time  id="error[time]" readonly="true"></et2-date-time>
					<et2-description  id="error[message]"></et2-description>
					<et2-description  value="Save job to clear error and restart it"></et2-description>
				</et2-vbox>
				<et2-template  id="filemanager.job.general"></et2-template>
				<et2-template  id="filemanager.job.custom"></et2-template>
			</tabpanels>
					</et2-tabbox>
		<et2-hbox  class="dialogMeta" hidden="!@id">
			<et2-description  value="Last modified" for="modifier"></et2-description>
			<et2-hbox>
				<et2-select-account  id="modifier" readonly="true"></et2-select-account>
				<et2-date-time  id="modified" readonly="true"></et2-date-time>
			</et2-hbox>
		</et2-hbox>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
					<et2-button  label="Save" id="button[save]"></et2-button>
					<et2-button  label="Apply" id="button[apply]"></et2-button>
					<et2-button  label="Cancel" id="button[cancel]"></et2-button>
					<et2-checkbox  label="Do not notify" id="no_notifications" statustext="Do not notify of these changes"></et2-checkbox>
					<et2-button  label="Delete" id="button[delete]" onclick="Et2Dialog.confirm(widget,'Delete this entry','Delete')" align="right"></et2-button>
					</et2-hbox>
	</et2-template>
</overlay>
