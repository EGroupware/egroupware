<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <et2-template  id="mail.index.preview">
        <!-- noPrint: mail.display's own equivalent toolbar (displayToolbar) already has this -
             this preview-pane toolbar was simply missing it, so it kept printing under Ctrl+P.
             Found live 2026-10-12 (ralf, following up on Stefan Unverricht's ctrl+P report). -->
        <et2-toolbar  id="toolbar" listHeader="short" class="noPrint"></et2-toolbar>
        <grid id="mailPreview" width="100%">
            <columns>
                <column/>
            </columns>
            <rows>
                <row class="th">

                </row>
                <row>
                    <et2-vbox  class="previewWrapper">
                        <et2-box  id="blank" disabled="@uid">
                            <et2-image  src="email"></et2-image>
                            <et2-description  value="Select an item to read"></et2-description>
                        </et2-box>
                        <et2-hbox  class="mailPreviewHeaders">
                            <et2-description  id="subject" readonly="true" hoverAction="app.mail.modifyMessageSubjectDialog" hoverActionTitle="Modify subject of this message"></et2-description>
                            <et2-hbox  class="mailPreviewHeaders smimeIcons">
                                <et2-image  id="smime_signature" src="smime_sign" inline="true" statustext="Smime signed message" hidden="!@smime=smime_sign" align="right" width="24"></et2-image>
                                <et2-image  id="smime_encryption" src="smime_encrypt" inline="true" statustext="Smime encrypted message" hidden="!@smime=smime_encrypt" align="right" width="24"></et2-image>
                                <!-- PGP/MIME signature status (MailApp.setPgpSignatureFlags(), mail/js/app.ts) - a
                                     different trust mechanism than S/MIME, deliberately not sharing its icon;
                                     hidden="true" by default (no server-side content field to bind a `hidden="!@..."`
                                     expression to like smime_signature's, PGP detection is 100% client-side/async) -
                                     .hidden/.set_class()/.set_statustext() driven entirely client-side by
                                     MailJmap.verifyPgpSignature(); .hidden specifically, NOT .disabled, which per
                                     Et2Widget's own docblock stays visible (just greyed out) -->
                                <et2-image  id="pgp_signature" src="envelope-at-fill" inline="true" hidden="true" align="right" width="24"></et2-image>
                                <!-- only shown while EGroupware itself is in dark mode, see app.less -->
                                <et2-button-toggle  id="mail_darkmode" class="mailDarkmodeToggle" onIcon="moon" offIcon="sun" statustext="Dark mode for mails" noSubmit="true" onchange="app.mail.toggleMailDarkmode"></et2-button-toggle>
                            </et2-hbox>
                        </et2-hbox>
                        <!-- onlyPrint: simpler, non-interactive layout (no avatar/toolbar/dropdown actions),
                             shown only for print media via CSS - same field ids/shape as mail.display's own
                             identical block (display.xet), which this was missing entirely: printing a
                             message from THIS preview pane (not the mail.display popup) showed no header
                             info at all - the avatar-containing interactive block below doesn't print
                             correctly (same class of shadow-DOM-vs-print issue as the message body itself,
                             see MailApp.preparePrint()'s own docblock), which is exactly why mail.display
                             already has this same print-only duplicate instead of relying on the interactive
                             block printing as-is. Found live 2026-10-12 (ralf, following up on Stefan
                             Unverricht's ctrl+P report). -->
                        <et2-vbox  width="100%" class="mailPreviewHeaders onlyPrint">
                            <et2-date-time  align="right" id="date" readonly="true" style="max-width: fit-content;"></et2-date-time>
                            <et2-vbox>
                                <et2-hbox>
                                    <et2-description  value="From" class="firstColumnTitle"></et2-description>
                                    <et2-email  id="additionalfromaddress" readonly="true"></et2-email>
                                </et2-hbox>
                                <et2-hbox  disabled="!@toaddress">
                                    <et2-description  value="To" class="firstColumnTitle"></et2-description>
                                    <et2-email  id="additionaltoaddress" readonly="true"></et2-email>
                                </et2-hbox>
                                <et2-hbox  disabled="!@ccaddress">
                                    <et2-description  value="Cc" class="firstColumnTitle"></et2-description>
                                    <et2-email  id="ccaddress" readonly="true"></et2-email>
                                </et2-hbox>
                                <et2-hbox  disabled="!@bccaddress">
                                    <et2-description  value="Bcc" class="firstColumnTitle"></et2-description>
                                    <et2-email  id="bccaddress" readonly="true"></et2-email>
                                </et2-hbox>
                            </et2-vbox>
                            <grid id="attachmentsBlock" class="attachments" disabled="!@attachmentsBlock">
                                <columns>
                                    <column/>
                                    <column width="70%"/>
                                    <column width="11%"/>
                                </columns>
                                <rows>
                                    <row class="row attachmentRow">
                                        <et2-description  id="${row}[type]"></et2-description>
                                        <et2-description-expose  class="et2_link useEllipsis" id="${row}[filename]" mime="$row_cont[type]" href="$row_cont[mime_url]" noLang="1" mimeData="$row_cont[mime_data]" onclick="app.mail.attachmentFilenameClick"></et2-description-expose>
                                        <et2-description  align="right" id="${row}[size]"></et2-description>
                                    </row>
                                </rows>
                            </grid>
                        </et2-vbox>
                        <!-- noPrint: normal interactive display, avatar + toolbar dropdown actions per attachment -->
                        <et2-hbox  width="100%" class="mailPreviewHeaders noPrint">
                            <et2-lavatar  contactId="email:$cont[fromaddress]" lname="$cont[fromlavatar][lname]" fname="$cont[fromlavatar][fname]" shape="rounded" size="2.75em"></et2-lavatar>
                            <et2-vbox>
                                <et2-vbox  class="addresses">
                                    <et2-hbox>
                                        <et2-description  value="From" class="firstColumnTitle"></et2-description>
                                        <et2-email  id="additionalfromaddress" readonly="true"></et2-email>
                                        <et2-date-time  align="right" id="date" readonly="true"></et2-date-time>
                                    </et2-hbox>
                                    <et2-hbox  disabled="!@toaddress" width="100%">
                                        <et2-description  value="To" class="firstColumnTitle"></et2-description>
                                        <et2-email  id="additionaltoaddress" readonly="true" rows="1" onTagClick="app.mail.onclickCompose"></et2-email>
                                    </et2-hbox>
                                    <et2-hbox  disabled="!@ccaddress" width="100%">
                                        <et2-description  value="Cc" class="firstColumnTitle"></et2-description>
                                        <et2-email  id="ccaddress" readonly="true" rows="1" onTagClick="app.mail.onclickCompose"></et2-email>
                                    </et2-hbox>
                                    <et2-hbox  disabled="!@bccaddress" width="100%">
                                        <et2-description  value="Bcc" class="firstColumnTitle"></et2-description>
                                        <et2-email  id="bccaddress" readonly="true" rows="1" onTagClick="app.mail.onclickCompose"></et2-email>
                                    </et2-hbox>
                                    <et2-hbox  width="100%" disabled="!@attachmentsBlock">
                                        <et2-description  value="Attachments" class="firstColumnTitle"></et2-description>
                                        <et2-details  overlaySummaryOnOpen="true" toggleAlign="right" toggleOnHover="true" hoist="true" class="attachments">
                                            <et2-hbox  slot="summary">
                                                <grid class="previewAttachmentArea egwGridView_grid">
                                                    <columns>
                                                        <column disabled="!@showtempname"/>
                                                        <column disabled="!@showtempname"/>
                                                        <column disabled="!@showtempname"/>
                                                        <column disabled="!@showtempname"/>
                                                        <column/>
                                                        <column/>
                                                    </columns>
                                                    <rows>
                                                        <row class="row attachmentRow">
                                                            <et2-description  id="attachmentsBlock[0][attachment_number]"></et2-description>
                                                            <et2-description  id="attachmentsBlock[0][partID]"></et2-description>
                                                            <et2-description  id="attachmentsBlock[0][type]"></et2-description>
                                                            <et2-description  id="attachmentsBlock[0][winmailFlag]"></et2-description>
                                                            <et2-description-expose  class="et2_link useEllipsis" id="attachmentsBlock[0][filename]" mime="@attachmentsBlock[0][type]" href="@attachmentsBlock[0][mime_url]" noLang="1" mimeData="@attachmentsBlock[0][mime_data]" onclick="app.mail.attachmentFilenameClick"></et2-description-expose>
                                                            <et2-description  align="right" value="@attachmentsBlockTitle" class="et2_bold"></et2-description>
                                                        </row>
                                                    </rows>
                                                </grid>
                                            </et2-hbox>
                                            <grid id="attachmentsBlock" class="previewAttachmentArea egwGridView_grid">
                                                <columns>
                                                    <column disabled="!@showtempname"/>
                                                    <column disabled="!@showtempname"/>
                                                    <column disabled="!@showtempname"/>
                                                    <column disabled="!@showtempname"/>
                                                    <column/>
                                                    <column/>
                                                    <column/>
                                                </columns>
                                                <rows>
                                                    <row class="row attachmentRow" id="${row}">
                                                        <et2-description  id="${row}[attachment_number]"></et2-description>
                                                        <et2-description  id="${row}[partID]"></et2-description>
                                                        <et2-description  id="${row}[type]"></et2-description>
                                                        <et2-description  id="${row}[winmailFlag]"></et2-description>
                                                        <et2-description-expose  class="et2_link useEllipsis" id="${row}[filename]" mime="$row_cont[type]" href="$row_cont[mime_url]" noLang="1" mimeData="$row_cont[mime_data]" onclick="app.mail.attachmentFilenameClick"></et2-description-expose>
                                                        <et2-description  align="right" id="${row}[size]"></et2-description>
                                                        <et2-dropdown-button  id="${row}[actions]" label="$row_cont[actionsDefaultLabel]" onchange="app.mail.attachmentsBlockActions" onclick="app.mail.attachmentsBlockActions"/>
                                                    </row>
                                                </rows>
                                            </grid>
                                        </et2-details>
                                    </et2-hbox>
                                </et2-vbox>
                            </et2-vbox>
                        </et2-hbox>
                    </et2-vbox>
                </row>
            </rows>
        </grid>
        <et2-box  id="mailPreviewContainer">
            <et2-ai>
                <et2-iframe  frameborder="1" id="messageIFRAME" scrolling="auto"></et2-iframe>
            </et2-ai>
        </et2-box>
    </et2-template>
    <et2-template  id="mail.index.rows.vertical" template="" lang="" group="0" version="1.9.001">
        <grid width="100%">
            <columns>
                <column width="80%"/>
                <!-- minWidth: ticket #126391 (Sam, 2026-10-13): this column holds the date AND the
                     status_icons row below it (status_icon, encryption, priority, attachment,
                     flagged - up to 5 icons; was 6 separate smime+pgp icons until the combined
                     `encryption` field just below, plus bfda361554 having added priority_icon
                     without widening this column at all, 2026-10-09) - plain width alone is a
                     resizable/savable preference a long-lived account's own stale saved value can
                     silently override down to something narrower than the template's own current
                     default (confirmed live: an existing test account's saved width rendered this
                     column at 114px instead of the declared 140, pushing the attachment/flag icons
                     out of view entirely, clipped behind the preview pane). minWidth is a hard
                     floor minmax() enforces regardless of any saved/stale width value. 120 fits 5
                     icons (5 * (1em+2px) + 4 gaps + the status_icons row's own margin-right: 1em)
                     with a little headroom, down from 140 (sized for 6, before the encryption
                     merge). -->
                <column width="120" minWidth="120"/>
            </columns>
            <rows>
                <row class="th">
                    <et2-nextmatch-sortheader  label="subject" id="subject"/>
                    <et2-nextmatch-sortheader  align="center" label="date" id="date" sortmode="DESC"/>
                </row>
                <row class="$row_cont[class]">
                    <et2-hbox  class="$row_cont[class]">
                        <et2-lavatar  contactId="email:$row_cont[address]" fname="$row_cont[lavatar][fname]" lname="$row_cont[lavatar][lname]" shape="rounded" loading="lazy"></et2-lavatar>
                        <et2-vbox  class="mail_row_content">
                            <et2-url-email  id="${row}[address]" class="$row_cont[class]" readonly="true" emailDisplay="preference" disableClickAction="true"></et2-url-email>
                            <et2-description  id="${row}[subject]" class="mail_subject useEllipsis $row_cont[class]" noLang="1"></et2-description>
                            <et2-description  id="${row}[bodypreview]" class="et2_label bodypreview" noLang="1"></et2-description>
                            <et2-category-box  id="${row}[labelTags]"></et2-category-box>
                        </et2-vbox>
                    </et2-hbox>
                    <et2-vbox>
                        <et2-hbox>
                            <et2-date-time-today  class="$row_cont[class]" id="${row}[date]" readonly="true"></et2-date-time-today>
                        </et2-hbox>
                        <!-- ticket #126391 follow-up: one combined slot for smime/pgp (a message's
                             Content-Type is one or the other, never both - see MailJmap's own
                             `encryption` field docblock, mail/js/jmap.ts) instead of two
                             almost-always-one-empty icons, to ease pressure on this column's width -->
                        <et2-hbox  class="status_icons">
                            <et2-image  src="$row_cont[status_icon]" class="status_img $row_cont[class]"></et2-image>
                            <et2-image  src="$row_cont[encryption]" inline="true" class="bi"></et2-image>
                            <et2-image  src="$row_cont[priority_icon]"></et2-image>
                            <et2-image  src="$row_cont[attachment_icon]"></et2-image>
                            <et2-image  src="$row_cont[flagged_icon]" id="flaggedImage"></et2-image>
                        </et2-hbox>
                    </et2-vbox>
                </row>
            </rows>
        </grid>
        <et2-styles  src="rows.css"></et2-styles>
    </et2-template>
    <et2-template  id="mail.index.splitter" height="100%" template="" lang="" group="0" version="1.9.001">
        <et2-split  id="mailSplitter" style="--min: 30%;--max:min(70%,calc(100% - 30em));" vertical="false">
            <et2-nextmatch  id="nm" onselect="app.mail.preview" template="mail.index.rows.vertical" autorefreshPreference="mail.index.rows" noDynheight="true"></et2-nextmatch>
            <et2-template  id="mail.index.preview"></et2-template>
        </et2-split>
    </et2-template>
    <et2-template  id="mail.index.rows.horizontal" template="" lang="" group="0" version="1.9.001">
        <grid width="100%">
            <columns>
                <column minWidth="60" maxWidth="60" width="60"/>
                <column width="20"/>
                <!-- minWidth: ticket #126391 - this column holds priority+attachment+flagged (3
                     icons since bfda361554 added priority_icon, 2026-10-09) - 20px never fit more
                     than one, see the vertical row template's own column just above for the full
                     explanation (same root cause, same fix). -->
                <column width="60" minWidth="60"/>
                <column width="40%"/>
                <column minWidth="42" width="95"/>
                <column width="95"/>
                <column width="95"/>
                <column width="30%"/>
                <column width="30%"/>
                <column width="80"/>
                <column width="80"/>
            </columns>
            <rows>
                <row class="th">
                    <et2-nextmatch-header  label="avatar" id="avatar"></et2-nextmatch-header>
                    <et2-nextmatch-header  statustext="Status" label="St." id="status"></et2-nextmatch-header>
                    <et2-nextmatch-header  statustext="attachments, ..." label="..." id="attachments"></et2-nextmatch-header>
                    <et2-nextmatch-sortheader  label="subject" id="subject"/>
                    <et2-nextmatch-sortheader  align="center" label="date" id="date" sortmode="DESC"/>
                    <et2-nextmatch-sortheader  align="center" label="arrival" id="arrival"/>
                    <et2-nextmatch-sortheader  label="mail-address" id="address"/>
                    <et2-nextmatch-sortheader  label="to" id="toaddress"/>
                    <et2-nextmatch-sortheader  label="from" id="fromaddress"/>
                    <et2-nextmatch-sortheader  align="center" label="size" id="size"/>
                    <et2-nextmatch-header  statustext="security" label="Security" id="security"></et2-nextmatch-header>
                </row>
                <row class="$row_cont[class]">
                    <et2-lavatar  contactId="email:$row_cont[address]" fname="$row_cont[lavatar][fname]" lname="$row_cont[lavatar][lname]" shape="rounded"></et2-lavatar>
                    <et2-hbox  class="status_icons">
                        <et2-image  src="$row_cont[status_icon]" class="status_img $row_cont[class]"></et2-image>
                    </et2-hbox>
                    <et2-hbox  class="status_icons">
                        <et2-image  src="$row_cont[priority_icon]"></et2-image>
                        <et2-image  src="$row_cont[attachment_icon]"></et2-image>
                        <et2-image  src="$row_cont[flagged_icon]" id="flaggedImage"></et2-image>
                    </et2-hbox>
                    <et2-vbox  class="mail_row_content">
                        <et2-description  id="${row}[subject]" class="mail_subject useEllipsis" noLang="1"></et2-description>
                        <et2-description  id="${row}[bodypreview]" class="et2_label bodypreview" noLang="1"></et2-description>
                        <et2-category-box  id="${row}[labelTags]"></et2-category-box>
                    </et2-vbox>
                    <et2-hbox>
                        <et2-date-time-today  align="center" id="${row}[date]" readonly="true"></et2-date-time-today>
                    </et2-hbox>
                    <et2-date-time-today  id="${row}[modified]" readonly="true"></et2-date-time-today>
                    <et2-url-email  id="${row}[address]" readonly="true" emailDisplay="preference" disableClickAction="true"></et2-url-email>
                    <et2-url-email  id="${row}[toaddress]" readonly="true" emailDisplay="preference" disableClickAction="true"></et2-url-email>
                    <et2-url-email  id="${row}[fromaddress]" readonly="true" emailDisplay="preference" disableClickAction="true"></et2-url-email>
                    <et2-vfs-size  align="right" id="${row}[size]" noLang="1" readonly="true"></et2-vfs-size>
                    <et2-hbox>
                        <!-- ticket #126391 follow-up: one combined smime/pgp slot, see the vertical
                             row template's own identical change just above for the full reasoning -->
                        <et2-image  align="center" src="$row_cont[encryption]" inline="true" class="horizontal_smime"></et2-image>
                    </et2-hbox>
                </row>
            </rows>
        </grid>
        <et2-styles  src="rows.css"></et2-styles>
    </et2-template>
    <et2-template  id="mail.index.nosplitter" template="" lang="" group="0" version="1.9.001">
        <et2-nextmatch  id="nm" onselect="app.mail.preview" template="mail.index.rows.horizontal" autorefreshPreference="mail.index.rows" noDynheight="true"></et2-nextmatch>
    </et2-template>
    <et2-template  id="mail.index.header" template="" lang="" group="0" version="1.9.001">
        <et2-button  id="button[mailcreate]" onclick="app.mail.composeMessage(false);" label="Compose" image="add" noSubmit="true"></et2-button>
        <et2-template  template="api.search-button"></et2-template>
        <et2-select  id="cat_id" ariaLabel="Search" class="et2-label-fixed" onchange="app.mail.changeNmFilter"/>
        <et2-select  id="filter" ariaLabel="Status" class="et2-label-fixed" onchange="app.mail.changeNmFilter"/>
        <!-- the same colored-flag list as the toolbar's flagging dropdown, but filtering the list
             instead of setting the flag - a col_filter, so it ANDs with the "Status" filter above
             rather than replacing it (options come from mail_ui::flagFilterOptions()) -->
        <et2-dropdown-button  id="flagFilter" label="Filter by flag" statustext="Filter by flag" iconOnly="true" onchange="app.mail.changeNmFilter" onclick="app.mail.changeNmFilter"></et2-dropdown-button>
        <et2-button-toggle  id="details" icon="card-text" statustext="Sneak preview in list" onchange="app.mail.toggleDetails"></et2-button-toggle>
        <!-- doc/ai/projects/mail-threaded-view.md, Phase 1 - hidden by default, MailApp.updateThreadingToggle()
             reveals it only for a profile whose JMAP bootstrap reports supportsThreading (nothing does, yet) -->
        <et2-button-toggle  id="threaded" icon="diagram-2" offIcon="list-ul" statustext="Group messages by thread" onchange="app.mail.toggleThreaded" style="display:none"></et2-button-toggle>
        <!-- icon/offIcon mirror the row's own unseen-message indicator (bi-circle-fill, see rows.less) -
             a filled circle vs. an outline one. Feature request 2026-10-13 (ralf): unseen messages
             first (newest first), then seen messages (newest first), instead of one flat date order. -->
        <et2-button-toggle  id="unseenFirst" icon="circle-fill" offIcon="circle" statustext="Unseen messages first" onchange="app.mail.toggleUnseenFirst"></et2-button-toggle>
        <et2-dropdown  id="mail.index.vacationnotice" disabled="true" class="vacationnotice" hoist="true" toggleOnHover="true">
            <et2-hbox  slot="trigger">
                <et2-description  value="on vacation" onclick="app.mail.editVacation"></et2-description>
                <et2-button-icon  image="chevron-down" noSubmit="true"></et2-button-icon>
            </et2-hbox>
            <et2-vbox  onclick="app.mail.editVacation">
                <et2-description  id="nm[vacationnotice]" class="@nm[vacationclass]"></et2-description>
                <et2-description  id="nm[vacationrange]" class="@nm[vacationrangeclass]"></et2-description>
            </et2-vbox>
        </et2-dropdown>
        <et2-hbox  id="mail.index.quotabox" class="mail-index_quotabox">
            <progress id="nm[quotainpercent]" label="@nm[quota]" class="@nm[quotaclass]"/>
        </et2-hbox>
    </et2-template>
    <et2-template  id="mail.index.dates" template="" lang="" group="0" version="1.9.001">
        <et2-date  id="startdate" label="Start" class="et2-label-fixed" style="padding-bottom: .3rem" onchange="widget.getParent().getWidgetById('enddate').set_min(widget.getValue());return true;"></et2-date>
        <et2-date  id="enddate" label="End" class="et2-label-fixed" onchange="widget.getParent().getWidgetById('startdate').set_max(widget.getValue());return true;"></et2-date>
    </et2-template>
    <et2-template  id="mail.index" template="" lang="" group="0" version="1.9.001">
        <et2-template  template="mail.index.header" slot="main-header"></et2-template>
        <et2-tree  id="nm[foldertree]" onclick="app.mail.changeFolder" onopenstart="app.mail.subscription_autoloadingStart" onopenend="app.mail.subscription_autoloadingEnd" highlighting="true" slot="left"/>
        <et2-template  id="splitter" height="100%" template="mail.index.splitter"></et2-template>
        <et2-iframe  frameborder="1" id="extra_iframe" scrolling="auto" disabled="true"></et2-iframe>
    </et2-template>
</overlay>
