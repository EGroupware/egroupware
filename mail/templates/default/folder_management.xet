<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="mail.folder_management" template="" lang="" group="0" version="1.9.001">
		<et2-hbox  class="dialogHeader" >
			<et2-description  value="Folder Management" class="mail_folder_management_header"></et2-description>
		</et2-hbox>
		<et2-hbox  class="treeContainer">
			<et2-tree  id="tree" multiple="true" onclick="app.mail.folderTreeSubselect" xOnselect="app.mail.folderManagementOnSelect"></et2-tree>
		</et2-hbox>
		<et2-hbox  class="dialogFooterToolbar">
			<et2-button  statustext="Delete selected folders" label="Delete" id="button[delete]" onclick="app.mail.folderManagementDeleteBtn"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" onclick="window.close()"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
