<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<template id="mail.index.rows" template="" lang="" group="0" version="1.9.001">
		<grid width="100%">
			<columns>
				<column width="50"/>
				<column width="90%"/>
				<column width="80"/>
			</columns>
			<rows>
				<row class="th">

				</row>
				<row class="$row_cont[class]">
					<et2-hbox>
						<et2-description  class="$row_cont[class] mobile_cat_col"></et2-description>
						<et2-lavatar  src="$row_cont[avatar]" lname="$row_cont[address]" shape="rounded"></et2-lavatar>
					</et2-hbox>
					<et2-vbox class="mail_row_content">
						<et2-url-email  id="${row}[address]" class="$row_cont[class]" readonly="true" emailDisplay="preference"></et2-url-email>
						<et2-description id="${row}[subject]" class="mail_subject useEllipsis $row_cont[class]" noLang="1"></et2-description>
						<et2-description  id="${row}[bodypreview]" class="et2_label bodypreview" noLang="1"></et2-description>
					</et2-vbox>
					<et2-vbox>
						<et2-hbox>
                            <et2-date-time-today class="$row_cont[class]" id="${row}[date]" readonly="true"></et2-date-time-today>
						</et2-hbox>
                        <et2-hbox class="status_icons">
							<et2-image src="$row_cont[status_icon]" class="status_img $row_cont[class]"></et2-image>
							<et2-image src="$row_cont[smime]" inline="true" class="bi"></et2-image>
							<et2-image src="$row_cont[attachment_icon]"></et2-image>
							<et2-image src="$row_cont[flagged_icon]" id="flaggedImage"></et2-image>
                        </et2-hbox>
					</et2-vbox>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</template>
	<template id="mail.index.rows.horizontal" template="" lang="" group="0" version="1.9.001">
		<grid width="100%">
			<columns>
				<column minWidth="60" maxWidth="60" width="60"/>
				<column width="20"/>
				<column width="20"/>
				<column width="40%"/>
				<column minWidth="42" width="95"/>
				<column width="95"/>
				<column width="95"/>
				<column width="30%"/>
				<column width="30%"/>
				<column width="80"/>
				<column width="80"/>
			</columns>
			<rows>
				<row class="th">
					<et2-nextmatch-header label="avatar" id="avatar"/>
					<et2-nextmatch-header statustext="Status" label="St." id="status"/>
					<et2-nextmatch-header statustext="attachments, ..." label="..." id="attachments"/>
					<et2-nextmatch-sortheader label="subject" id="subject"/>
					<et2-nextmatch-sortheader align="center" label="date" id="date" sortmode="DESC"/>
					<et2-nextmatch-sortheader align="center" label="arrival" id="arrival"/>
					<et2-nextmatch-sortheader label="mail-address" id="address"/>
					<et2-nextmatch-sortheader label="to" id="toaddress"/>
					<et2-nextmatch-sortheader label="from" id="fromaddress"/>
					<et2-nextmatch-sortheader align="center" label="size" id="size"/>
					<et2-nextmatch-header statustext="security" label="Security" id="security"/>
				</row>
				<row class="$row_cont[class]">
					<et2-lavatar contactId="email:$row_cont[address]" fname="$row_cont[lavatar][fname]"
								 lname="$row_cont[lavatar][lname]" shape="rounded"></et2-lavatar>
					<et2-image src="$row_cont[status_icon]" class="status_img $row_cont[class]"></et2-image>
					<et2-hbox class="status_icons">
						<et2-image src="$row_cont[attachment_icon]"></et2-image>
						<et2-image src="$row_cont[flagged_icon]" id="flaggedImage"></et2-image>
					</et2-hbox>
					<et2-vbox class="mail_row_content">
						<et2-description id="${row}[subject]" class="mail_subject useEllipsis" noLang="1"></et2-description>
						<et2-description id="${row}[bodypreview]" class="et2_label bodypreview"
										 noLang="1"></et2-description>
					</et2-vbox>
					<et2-hbox>
						<et2-date-time-today align="center" id="${row}[date]" readonly="true"></et2-date-time-today>
					</et2-hbox>
					<et2-date-time-today id="${row}[modified]" readonly="true"></et2-date-time-today>
					<et2-url-email id="${row}[address]" readonly="true" emailDisplay="preference"></et2-url-email>
					<et2-url-email id="${row}[toaddress]" readonly="true" emailDisplay="preference"></et2-url-email>
					<et2-url-email id="${row}[fromaddress]" readonly="true" emailDisplay="preference"></et2-url-email>
					<et2-vfs-size align="right" id="${row}[size]" noLang="1" readonly="true"></et2-vfs-size>
					<et2-image src="$row_cont[smime]" inline="true"></et2-image>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</template>
    <et2-template id="mail.index.dates" template="" lang="" group="0" version="1.9.001">
        <et2-date id="startdate" label="Start" class="et2-label-fixed" style="padding-bottom: .3rem"
                  onchange="widget.getParent().getWidgetById('enddate').set_min(widget.getValue());return true;"></et2-date>
        <et2-date id="enddate" label="End" class="et2-label-fixed"
                  onchange="widget.getParent().getWidgetById('startdate').set_max(widget.getValue());return true;"></et2-date>
    </et2-template>
	<template id="mail.index" template="" lang="" group="0" version="1.9.001">
        <et2-tree id="nm[foldertree]" onclick="app.mail.changeFolder" parent_node="mail-tree_target" slot="left"/>
		<html id="msg"/>
		<et2-hbox  class="mail-index_vacation"><et2-vbox>
			<et2-description  id="nm[vacationnotice]" class="@nm[vacationclass]"></et2-description>
			<et2-description  id="nm[vacationrange]" class="@nm[vacationrangeclass]"></et2-description></et2-vbox>
		</et2-hbox>
        <et2-nextmatch id="nm" onselect="app.mail.preview" template="mail.index.rows"></et2-nextmatch>
		<et2-button  id="composeMail" class="plus_button" onclick="app.mail.composeMessage(false);" size="large" image="plus" circle="true" noSubmit="true"></et2-button>
	</template>
</overlay>
