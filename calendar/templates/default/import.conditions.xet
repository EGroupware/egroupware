<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="calendar.import.conditions" template="" lang="" group="0" version="16.1">
		<et2-template  id="importexport.wizard_basic_import_csv.conditions" disabled="@no_conditions"></et2-template>
		<et2-hbox>
			<et2-description  value="Do not import conflicting events"></et2-description>
			<et2-checkbox  id="skip_conflicts" ></et2-checkbox>
		</et2-hbox>
	</et2-template>
</overlay>
