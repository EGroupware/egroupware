<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="calendar.add" template="" lang="" group="0" version="19.1.000" layout="edit" style="--label-width:5em; --column-min-width:30em">
		<et2-hbox  class="dialogHeader">
			<et2-appicon></et2-appicon>
			<et2-textbox  id="title" maxlength="255" tabindex="1" required="true" placeholder="Title" style="flex:1"></et2-textbox>
		</et2-hbox>
		<et2-date-time  label="Start" id="start" onchange="app.calendar.edit_start_change" required="true" dataFormat="object"></et2-date-time>
		<et2-hbox>
			<et2-select  label="Duration" class="et2-label-fixed" style="min-width:16em" statustext="Duration of the meeting" id="duration" onchange="app.calendar.set_enddate_visibility" noLang="1" emptyLabel="Use end date"></et2-select>
			<et2-date-time  label="End" id="end" onchange="app.calendar.edit_update_participant" freeMinuteEntry="true" dataFormat="object"></et2-date-time>
		</et2-hbox>
		<et2-button  statustext="saves the changes made" label="Save" id="button[save]" slot="footer" default="true"></et2-button>
		<et2-button  statustext="Full edit dialog" label="Edit" id="button[edit]" noValidation="true" slot="footer"></et2-button>
		<et2-button  statustext="Close the window" label="Cancel" id="button[cancel]" noValidation="true" slot="footer"></et2-button>
		<et2-checkbox  label="Always use full edit dialog" id="new_event_dialog" statustext="Always use the full edit dialog, not this little dialog" onchange="egw.set_preference('calendar',widget.id,widget.get_value() ? 'edit' : 'add');" slot="footer" align="right"></et2-checkbox>
	</et2-template>
</overlay>
