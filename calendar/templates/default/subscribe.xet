<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="calendar.subscribe" template="" lang="" group="0" version="19.2" layout="edit">
		<et2-select  label="Subscriptions" id="cat_id" emptyLabel="Create a new subscription" onchange="widget.getInstanceManager().submit(null,false,true); return false;" span="all"></et2-select>
		<et2-textbox  label="Name" id="name" tabindex="1" maxlength="255" required="true" span="all"></et2-textbox>
		<et2-url  label="URL" id="url" required="true" span="all"></et2-url>
		<et2-textbox  label="Username" id="user"></et2-textbox>
		<et2-password  label="Password" id="password" autocomplete="new-password"></et2-password>
		<et2-select  label="Calendar" id="calendar" emptyLabel="Select one..." required="true" hidden="!@show_calendar_selection"></et2-select>
		<et2-calendar-owner  label="Additional participants" id="participants" multiple="true" span="all"></et2-calendar-owner>
		<et2-hbox>
			<et2-description  value="Modify events" style="width:var(--label-width, 8em); margin-right:var(--sl-spacing-medium)"></et2-description>
			<et2-checkbox  id="set_private" label="private" statustext="Does NOT show event to other users, unless they have a private grant"></et2-checkbox>
		</et2-hbox>
		<et2-select  id="blocking" label="Blocking" emptyLabel="From file" statustext="A non blocking event will not conflict with other events"></et2-select>
		<et2-colorpicker  label="Color" id="color"></et2-colorpicker>
		<et2-select  label="Icon" id="icon" emptyLabel="None" search="true" searchUrl="preferences.preferences_categories_ui.ajax_search"></et2-select>
		<et2-select  label="Automatic update" id="sync_frequence">
			<option value="">Never</option>
			<option value="1440">daily</option>
			<option value="480">8 {hours}</option>
			<option value="240">4 {hours}</option>
			<option value="120">2 {hours}</option>
			<option value="60">1 {hour}</option>
			<option value="30">30 {minutes}</option>
			<option value="15">15 {minutes}</option>
			<option value="5">5 {minutes}</option>
		</et2-select>
		<et2-hbox  class="dialogFooterToolbar" style="min-width:0">
			<et2-button  accesskey="s" label="Save" id="button[save]" hideOnReadonly="true"></et2-button>
			<et2-button  label="Apply" id="button[apply]" hideOnReadonly="true"></et2-button>
			<et2-button  label="Cancel" id="button[cancel]" onclick="window.close(); return false;" hideOnReadonly="true"></et2-button>
			<et2-button  align="right" label="Sync now" id="button[sync]" image="arrow-repeat"></et2-button>
			<et2-button  align="right" label="Delete" id="button[delete]" onclick="Et2Dialog.confirm(widget,'Do you want to delete this subscription incl. the synced events?','Delete')"></et2-button>
		</et2-hbox>
	</et2-template>
</overlay>
