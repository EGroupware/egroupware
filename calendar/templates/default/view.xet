<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">

<overlay>
    <et2-template  id="calendar.view">
		<grid id="view" width="100%">
			<columns>
				<column/>
			</columns>
			<rows>
				<row class="view_row">
                    <calendar-timegrid id="${row}"
                                       onchange="if(!widget.options) return; let state = {}; if(widget.options.start_date == widget.options.end_date) state.view = 'day'; app.calendar.update_state(state);"
						onevent_change="app.calendar.event_change"
					>
					</calendar-timegrid>
				</row>
			</rows>
		</grid>
	</et2-template>
</overlay>
