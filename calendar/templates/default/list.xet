<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="calendar.list.dates" template="" lang="" group="0" version="1.3.001">
		<et2-hbox>
			<et2-description  value="Start"></et2-description>
			<et2-date  id="startdate" onchange="widget.getParent().getWidgetById('enddate').set_min(widget.getValue()); app.calendar.update_state({date: widget.getValue()}); return false;"></et2-date>
			<et2-description  value="End"></et2-description>
			<et2-date  id="enddate" onchange="widget.getParent().getWidgetById('startdate').set_max(widget.getValue()); app.calendar.update_state({end_date: widget.getValue()}); return false;"></et2-date>
		</et2-hbox>
	</et2-template>
	<et2-template  id="calendar.list.rows" template="" lang="" group="0" version="1.9.004">
		<grid>
			<columns>
				<column width="125"/>
				<column width="80%"/>
				<column width="40%"/>
				<column width="40%"/>
				<column width="135"/>
				<column width="120"/>
				<column width="120"/>
				<column width="120"/>
				<column width="120"/>
				<column width="120"/>
				<column width="130"/>
				<column width="20%"/>
			</columns>
			<rows>
				<row class="th">
					<et2-vbox>
						<et2-nextmatch-sortheader  label="Start" id="cal_start"/>
						<et2-nextmatch-sortheader  label="End" id="cal_end"/>
					</et2-vbox>
					<et2-vbox>
						<et2-nextmatch-sortheader  label="Title" id="cal_title"/>
						<et2-nextmatch-sortheader  label="Description" id="cal_description"/>
					</et2-vbox>
					<et2-nextmatch-sortheader  label="Title" id="cal_title"/>
					<et2-nextmatch-sortheader  label="Description" id="cal_description"/>
					<et2-nextmatch-header  label="Recurrence" id="recure"></et2-nextmatch-header>
					<et2-nextmatch-header  label="Category" id="cat_id"></et2-nextmatch-header>
					<et2-vbox>
						<et2-nextmatch-sortheader  label="Owner" id="cal_owner" readonly="true"/>
						<et2-nextmatch-sortheader  label="Location" id="cal_location"/>
					</et2-vbox>
					<et2-nextmatch-sortheader  label="Owner" id="cal_owner" readonly="true"/>
					<et2-nextmatch-sortheader  label="Location" id="cal_location"/>
					<et2-nextmatch-header  label="Participants" id="participant" statustext="Use side menu to filter participants"></et2-nextmatch-header>
					<et2-vbox>
						<et2-nextmatch-sortheader  label="Created" id="cal_created" sortmode="DESC"/>
						<et2-nextmatch-header  label="Creator" id="cal_creator"></et2-nextmatch-header>
						<et2-description  value="Last changed"></et2-description>
					</et2-vbox>
					<et2-nextmatch-header-customfields  label="Custom fields" id="cfs" app="calendar" readonly="true"/>
				</row>
				<row class="$row_cont[category] $row_cont[class]" valign="top">
					<et2-vbox  id="start">
						<et2-date-time  id="${row}[start]" readonly="true" class="noWrap"></et2-date-time>
						<et2-date-time  id="${row}[end]" readonly="true" class="noWrap"></et2-date-time>
					</et2-vbox>
					<et2-vbox  class="listVbox">
						<et2-hbox  readonly="true" noLang="1">
							<et2-description  id="${row}[title]" readonly="true" noLang="1" fontStyle="b"></et2-description>
							<et2-description  align="right" value="#%s" id="${row}[id]" fontStyle="b"></et2-description>
						</et2-hbox>
						<et2-box  class="listDescription" noLang="1">
							<et2-description  id="${row}[description]" noLang="1" activateLinks="1"></et2-description>
						</et2-box>
						<et2-description  id="${row}[recure]" noLang="1"></et2-description>
					</et2-vbox>
					<et2-hbox>
						<et2-description  id="${row}[title]"></et2-description>
						<et2-description  align="right" value="#%s" id="${row}[id]" fontStyle="b"></et2-description>
					</et2-hbox>
					<et2-description  id="${row}[description]" noLang="1" activateLinks="1"></et2-description>
					<et2-description  id="${row}[recure]"></et2-description>
					<et2-select-cat  id="${row}[category]" readonly="true"></et2-select-cat>
					<et2-vbox>
						<et2-select-account  class="noWrap" id="${row}[owner]" readonly="true"></et2-select-account>
						<et2-description  id="${row}[location]" noLang="1" activateLinks="1"></et2-description>
					</et2-vbox>
					<et2-select-account  class="noWrap" id="${row}[owner]" readonly="true"></et2-select-account>
					<et2-description  id="${row}[location]" noLang="1" activateLinks="1"></et2-description>
					<et2-html  id="${row}[parts]" readonly="true" noLang="1"></et2-html>
					<et2-vbox>
						<et2-date-time  id="${row}[created]" readonly="true"></et2-date-time>
						<et2-select-account  id="${row}[creator]" readonly="true"></et2-select-account>
						<et2-date-time  id="${row}[modified]" readonly="true"></et2-date-time>
					</et2-vbox>
					<et2-customfields-list  id="$row" app="calendar"/>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</et2-template>
	<et2-template  id="calendar.list" template="" lang="" group="0" version="1.9.003">
		<!-- The nextmatch is a direct child, not wrapped in a <grid> as it used to be: a grid is a
		     real <table>, and a table cell can not constrain its child's height, so et2-datagrid
		     never got a bounded box to scroll inside and grew to fit every row instead.  The
		     legacy grid widget also can not adopt a web component as a child at all
		     ("Legacy widget grid[#] could not handle adding a child (ET2-NEXTMATCH)"). -->
		<et2-html  id="css" disabled="!@css"></et2-html>
		<et2-nextmatch  id="nm" template="calendar.list.rows" filter_template="">
			<et2-template  id="calendar.list.dates" slot="header"></et2-template>
		</et2-nextmatch>
	</et2-template>
</overlay>
