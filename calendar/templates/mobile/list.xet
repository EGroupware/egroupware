<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<!-- $Id: list.xet 54765 2016-01-19 00:48:21Z nathangray $ -->
<overlay>
	<et2-template  id="calendar.list.add" template="" lang="" group="0" version="16.1.001">
		<et2-button-icon  id="add" class="plus_button" onclick="egw.open('calendar');" parentId="calendar-list_plus_button_container" image="plus-lg"></et2-button-icon>
	</et2-template>
	<et2-template  id="calendar.list.dates" template="" lang="" group="0" version="1.3.001">
		<et2-hbox>
			<et2-description  value="Start"></et2-description>
			<et2-date  id="startdate" onchange="app.calendar.update_state({date: widget.getValue()}); return false;"></et2-date>
			<et2-description  value="End"></et2-description>
			<et2-date  id="enddate" onchange="app.calendar.update_state({end_date: widget.getValue()}); return false;"></et2-date>
		</et2-hbox>
	</et2-template>
	<et2-template  id="calendar.list.rows" template="" lang="" group="0" version="1.9.004">
		<grid width="100%" >
			<columns>
				<column width="100%" />
			</columns>
			<rows>
				<row class="th">
					<!-- The mobile skin hides the header row entirely (kdots mobile.less), but the
					     row template still needs one to define its columns.  A plain header with an
					     id of its own, deliberately not one of the real column names the desktop
					     skin and $content[nm][default_cols] use - both skins share the row template
					     name, and so the column preference that goes with it. -->
					<et2-nextmatch-header  label="Event" id="mobile_event"></et2-nextmatch-header>
				</row>
				<row class="$row_cont[category] $row_cont[class]" valign="top">
					<et2-vbox  class="calendar_fullWidth">
						<et2-customfields-list  id="$row" class="customfields" app="calendar" disabled="true"/>
						<et2-hbox  class="calTitleRow">
							<et2-description  id="${row}[title]" class="calTitle et2_ellipsis" overflow="hidden" width="100%" noLang="1"></et2-description>
						</et2-hbox>
						<et2-hbox  class="calDates">
							<et2-date-time-today  id="${row}[start]" readonly="true" class="noWrap"></et2-date-time-today>
							<et2-description  class="dash" value="-"></et2-description>
							<et2-date-time-today  id="${row}[end]" readonly="true" class="noWrap"></et2-date-time-today>
						</et2-hbox>
					</et2-vbox>
				</row>
			</rows>
		</grid>
		<et2-styles src="rows.css"></et2-styles>
	</et2-template>
	<et2-template  id="calendar.list" template="" lang="" group="0" version="1.9.003">
		<!-- All direct children, no wrapping <grid>: a grid is a real <table>, and a table cell
		     can not constrain its child's height, so et2-datagrid would have no bounded box to
		     scroll inside.  The legacy grid widget also can not adopt a web component at all. -->
		<et2-html  id="css" disabled="!@css"></et2-html>
		<et2-nextmatch  id="nm" template="calendar.list.rows" filter_template="">
			<et2-template  id="calendar.list.dates" slot="header"></et2-template>
			<et2-template  id="calendar.list.add" slot="header"></et2-template>
		</et2-nextmatch>
		<et2-description  align="center" id="msg" class="message" noLang="1"></et2-description>
		<et2-description  id="plus_button_container"></et2-description>
	</et2-template>
</overlay>
